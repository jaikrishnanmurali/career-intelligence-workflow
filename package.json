{
  "name": "career-intelligence-workflow",
  "version": "1.3.0",
  "private": true,
  "description": "Always-on job discovery and Resend email digests for Career Ops.",
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "init": "node scripts/init.mjs",
    "integrate:career-ops": "node scripts/integrate-career-ops.mjs",
    "sync:career-ops": "node scripts/import-career-ops-profile.mjs",
    "sources:provision": "node scripts/provision-sources.mjs",
    "workflow:install": "node scripts/install-workflow.mjs",
    "test": "node --test",
    "scan:structured": "node scripts/run-structured-scan.mjs",
    "scan:career-ops": "node scripts/run-career-ops-scan.mjs",
    "intake:poll": "node scripts/poll-alerts.mjs",
    "mail:doctor": "node scripts/mail-doctor.mjs",
    "update:check": "node scripts/check-updates.mjs",
    "smoke": "node scripts/smoke.mjs",
    "setup:status": "node scripts/setup-progress.mjs show",
    "status": "node scripts/status.mjs",
    "pause": "node scripts/lifecycle.mjs pause",
    "resume": "node scripts/lifecycle.mjs resume",
    "snooze": "node scripts/lifecycle.mjs snooze"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "bin": {
    "career-intelligence-workflow": "bin/cli.mjs"
  },
  "author": "Jai Krishnan Murali",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaikrishnanmurali/career-intelligence-workflow.git"
  },
  "keywords": [
    "career-ops",
    "job-search",
    "email-digest",
    "resend",
    "github-actions",
    "automation"
  ],
  "files": [
    ".agents/skills/",
    ".claude/skills/",
    ".env.example",
    ".gitignore",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE",
    "README.md",
    "ROADMAP.md",
    "SECURITY.md",
    "bin/",
    "config/profile.example.yml",
    "config/source-packs.example.yml",
    "docs/",
    "examples/",
    "integrations/",
    "modes/",
    "reports/latest.example.json",
    "schemas/",
    "scripts/",
    "src/",
    "state/state.example.json",
    "tests/"
  ]
}

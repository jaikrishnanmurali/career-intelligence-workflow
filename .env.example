# Local email testing only. Never commit a real .env file.
RESEND_API_KEY=
CAREER_DIGEST_FROM="Career Intelligence <onboarding@resend.dev>"
CAREER_DIGEST_TO="the-email-used-for-your-resend-account@example.com"

# Optional eight-platform alert intake. Receiving requires a separate Resend
# full-access key; keep the digest key sending-only.
RESEND_RECEIVING_API_KEY=
RESEND_RECEIVING_ADDRESS=

# Smart cloud-provider credentials belong in GitHub Actions secrets, not this file.
# Codex: OPENAI_API_KEY
# Claude Code: CLAUDE_CODE_OAUTH_TOKEN
